{
  "name": "canvagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local Codex harness with a canvas shared by you and your agent",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "brand:build": "node scripts/build-brand.mjs",
    "dev": "concurrently -k -n server,web 'node --import tsx --watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:codex-tools": "node --import tsx scripts/smoke-tool-refresh.ts",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "desktop:check": "npm run desktop:prepare && node scripts/tauri.mjs check",
    "test:desktop": "node --import tsx --test tests/desktop/*.test.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.29",
    "@assistant-ui/react-markdown": "0.14.23",
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.1.0",
    "fractional-indexing": "^3.4.0",
    "image-size": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
