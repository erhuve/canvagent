{
  "name": "canvagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local Codex harness with a canvas shared by you and your agent",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web 'node --import tsx --watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "express": "^5.1.0",
    "image-size": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
